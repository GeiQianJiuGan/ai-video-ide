# ==============================================================================
# AI Video Studio Docker 部署环境变量配置
# 使用方法：复制本文件为 .env 并根据实际情况修改
# cp .env.docker.example .env
# ==============================================================================

# 前端默认只绑定本机。远程访问请用 SSH 隧道，或在认证反向代理后面访问。
AIVS_BIND_ADDR=127.0.0.1
AIVS_WEB_PORT=8080

# ----------------- 镜像版本 -----------------
# compose 用它拼镜像 tag（aivs-backend:<这里的值>）。留空或不写 = latest。
# 想跑 scripts/package-docker.py 打出来的那一版就填那个版本号，例如 0.1.0。
AIVS_VERSION=

# ----------------- 外部 ComfyUI 算力机连接 -----------------
# 算力机地址（注意：请填写算力机的实际内网/公网 IP，不要使用 127.0.0.1）
AIVS_COMFY_BASE_URL=http://192.168.1.100:8188

# ----------------- LLM 协作配置（可选，默认 none 可关闭） -----------------
# 可选值: none | openai_compatible | anthropic | ollama
AIVS_LLM_PROVIDER=none
AIVS_LLM_BASE_URL=https://api.openai.com/v1
AIVS_LLM_API_KEY=
AIVS_LLM_MODEL=gpt-4o-mini
