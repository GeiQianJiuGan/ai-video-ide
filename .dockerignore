# Git & IDE
.git
.gitignore
.claude
.idea
.vscode
*.swp
*.swo

# Node / Frontend
**/node_modules
frontend/dist
frontend/.vite

# Python / Backend
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache
**/.ruff_cache
backend/.venv
backend/aivs_backend.egg-info
.venv

# Runtime & Local Data (should be mounted via volumes)
.runtime
data
bin
exports
imports
cache
logs
*.log
*.sqlite
*.db

# 打包产物：dist/docker 里是上一次 docker save 出来的 tar（好几个 GB），
# 不排掉的话每次构建都要先把它们传给 daemon 当上下文，越打越慢。
dist
tauri/target
.tmp-pytest
